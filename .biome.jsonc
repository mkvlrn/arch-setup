{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/node_modules/**/*",
      "!**/build/**/*",
      "!**/coverage/**/*",
      "!**/*.d.ts",
      "!index.html"
    ]
  },
  "extends": ["@mkvlrn/config/biome"],
  "overrides": [
    {
      "includes": ["**/*.ts"],
      "javascript": { "globals": ["Bun"] },
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "correctness": { "noNodejsModules": "off" }
        }
      }
    }
  ]
}
