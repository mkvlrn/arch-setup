{
  "repo": {
    "http": "https://github.com/mkvlrn/arch-setup",
    "ssh": "git@github.com:mkvlrn/arch-setup"
  },
  "mise": {
    "tools": ["go", "bun"],
    "settings": [["auto_update", "true"], ["auto_update_check_duration", "3d"]]
  },
  "pacman": {
    "install": ["git", "stow"],
    "uninstall": ["vim"]
  },
  "yay": {
    "mirrorListPath": "path",
    "mirrorListCheck": "check",
    "packages": ["zed", "zen-browser-bin"]
  },
  "xdg": {
    "mkdir": ["documents", "downloads"],
    "rmrf": ["Documents", "Downloads"]
  },
  "getnf": ["Hack", "IosevkaTerm"]
}
