{
  "basePackages": ["git", "base-devel", "reflector", "stow"],
  "removePackages": ["vim", "cosmic-terminal"],
  "mainPackages": [
    "age",
    "bruno-bin",
    "deluge-gtk",
    "deluge",
    "docker-buildx",
    "docker-compose",
    "docker",
    "dolphin",
    "firefox",
    "fish",
    "flatpak",
    "ghostty",
    "gnome-keyring",
    "keychain",
    "less",
    "okular",
    "openssh",
    "pacman-contrib",
    "power-profiles-daemon",
    "pure-ftpd",
    "qalculate-qt",
    "ttf-hack-nerd",
    "ttf-iosevkaterm-nerd",
    "ttf-zed-mono-nerd",
    "unzip",
    "visual-studio-code-bin",
    "xdg-user-dirs",
    "zed"
  ],
  "flatpakApplets": [
    "com.github.DiegoMMR.CosmicExtAppletNowPlaying",
    "io.github.cosmic_utils.cosmic-ext-applet-clipboard-manager",
    "io.github.crocodile.cosmic-ext-applet-workspace-icons"
  ],
  "repoHttp": "https://github.com/mkvlrn/arch-setup",
  "repoSsh": "git@github.com:mkvlrn/arch-setup",
  "mirrorListPath": "/etc/pacman.d/mirrorlist",
  "mirrorListCheck": "# With:       reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist",
  "xdgMkDir": ["repos", "work", "documents", "downloads", "media", "torrents"],
  "xdgRmRf": [
    "Desktop",
    "Documents",
    "Downloads",
    "Music",
    "Pictures",
    "Projects",
    "Public",
    "Templates",
    "Videos"
  ]
}
