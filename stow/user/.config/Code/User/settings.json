{
  /*
   * ============================================================================
   * LANGUAGES
   * ============================================================================
   */

  // go
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "go.lintOnSave": "package",
  "go.lintTool": "golangci-lint-v2",
  "go.lintFlags": ["--path-mode=abs"],
  "gopls": {
    "formatting.gofumpt": true,
    "ui.semanticTokens": true
  },
  "go.alternateTools": {
    "golangci-lint-v2": "/home/mkvlrn/.local/share/mise/shims/golangci-lint"
  },
  // go

  // js ts html css json
  "[css][jsonc][json][javascript][javascriptreact][typescript][typescriptreact][html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  // js ts html css json

  // emmet
  "emmet.triggerExpansionOnTab": true,
  "emmet.syntaxProfiles": {
    "javascript": "html",
    "typescript": "html"
  },
  // emmet

  // docker
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "docker.docker",
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true
    }
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "docker.extension.enableComposeLanguageServer": false,
  // docker

  // yaml
  "[yaml][yml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // yaml

  // toml
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  // toml

  // shell dotenv properties gitignore
  "[properties][shellscript][dotenv][ignore]": {
    "editor.defaultFormatter": "lumirelle.shell-format-rev"
  },
  // shell dotenv properties gitignore

  // markdown
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // markdown

  /*
   * ============================================================================
   * EDITOR
   * ============================================================================
   */

  // appearance
  "editor.fontFamily": "ZedMono Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontSize": 22,
  "editor.codeLens": true,
  "editor.codeLensFontSize": 10,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveBracketPair": true,
  "editor.guides.highlightActiveIndentation": "always",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [80, 100],
  "editor.stickyScroll.enabled": false,
  "catppuccin-icons.associations.files": {
    ".gitconfig.work": "git"
  },
  // appearance

  // behavior
  "editor.accessibilitySupport": "off",
  "editor.autoClosingBrackets": "always",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.links": false,
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 100,
  // behavior

  // formatting
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.biome": "never",
    "source.fixAll": "explicit",
    "source.fixAll.sortJSON": "never",
    "source.organizeImports": "explicit",
    "source.sortImports": "explicit"
  },
  // formatting

  /*
   * ============================================================================
   * WORKBENCH / UI
   * ============================================================================
   */
  // theme, layout
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.activityBar.location": "top",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.showLabels": false,
  // theme, layout

  // tabs, startup
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.labelFormat": "medium",
  "workbench.editor.tabSizing": "fit",
  "workbench.editor.wrapTabs": true,
  "workbench.editor.useModal": "off",
  "workbench.startupEditor": "none",
  // tabs, startup

  // settings, ui
  "workbench.settings.editor": "json",
  "workbench.settings.useSplitJSON": false,
  // settings, ui

  /*
   * ============================================================================
   * WINDOW
   * ============================================================================
   */
  "window.customTitleBarVisibility": "auto",
  "window.density.editorTabHeight": "compact",
  "window.newWindowDimensions": "maximized",
  "window.restoreWindows": "none",
  "window.titleBarStyle": "custom",

  /*
   * ============================================================================
   * TERMINAL / DEBUG
   * ============================================================================
   */

  // terminal
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.environmentChangesRelaunch": true,
  "terminal.integrated.fontFamily": "IosevkaTerm Nerd Font",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 20,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  // terminal

  // debug console
  "debug.console.fontFamily": "IosevkaTerm Nerd Font",
  "debug.console.fontSize": 20,
  // debug console

  /*
   * ============================================================================
   * FILES / EXPLORER
   * ============================================================================
   */

  // files
  "files.eol": "\n",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.dotfiles": false,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "node_modules": false
  },
  "files.watcherExclude": {
    "**/.dotfiles": false,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true
  },
  "files.associations": {
    ".gitconfig.work": "properties"
  },
  // files

  // explorer
  "explorer.compactFolders": false,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": false,
  "breadcrumbs.filePath": "off",
  // explorer

  /*
   * ============================================================================
   * GIT
   * ============================================================================
   */
  "git.confirmSync": true,
  "diffEditor.ignoreTrimWhitespace": false,

  /*
   * ============================================================================
   * EXTENSIONS / TOOLING
   * ============================================================================
   */

  // extensions
  "extensions.ignoreRecommendations": true,
  // extensions

  // spell checking
  "cSpell.language": "en,pt_BR",
  "cSpell.useCustomDecorations": true,
  "cSpell.textDecorationColor": "green",
  "cSpell.textDecorationColorFlagged": "green",
  // spell checking

  // json schemas
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://docs.renovatebot.com": true,
    "https://github.com": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  // json schemas

  /*
   * ============================================================================
   * PRIVACY / AI
   * ============================================================================
   */

  // ai
  "chat.disableAIFeatures": true,
  // ai

  // telemetry
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  // telemetry

  /*
   * ============================================================================
   * MISC
   * ============================================================================
   */
  "update.mode": "none",
  "makefile.configureOnOpen": false,
  "security.workspace.trust.untrustedFiles": "open"
}
