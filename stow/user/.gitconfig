[user]
  name = mkvlrn
  email = dev@mkvlrn.cc
  signingkey = "~/.ssh/dev_signing"
[init]
  defaultBranch = main
[core]
  editor = zeditor --wait
  autocrlf = false
  safecrlf = false
  eol = lf
  excludesFile = "~/.gitignore_global"
  sshCommand = ssh -i ~/.ssh/dev -o IdentitiesOnly=yes
[push]
  followTags = true
[pull]
  rebase = false
[gpg]
  format = ssh
[commit]
  gpgsign = true
[alias]
  k = !git add --all && git commit -m
  s = !git status -s
  l = !git log --pretty=format:'%C(blue)%h%C(red)%d %C(white)%s - %C(cyan)%cn, %C(green)%cr'
  a = !git add --all && git commit --amend --no-edit -m
  t = !git log --graph --decorate --abbrev-commit --pretty=format:'%C(yellow)%h%Creset %C(magenta)%ad%Creset%C(auto)%d%Creset %s %C(cyan)[%an]%Creset' --date=short
[credential "helperselector"]
  selected = <no helper>

# Subfolder configs
[includeIf "gitdir:~/work/"]
  path = "~/.gitconfig.work"
