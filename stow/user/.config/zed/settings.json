// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true
    },
    "flexible": false,
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
      "effort": "low"
    },
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "default_profile": "write"
  },
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no",
    "provider": "zed"
  },
  "auto_indent_on_paste": false,
  "auto_install_extensions": {
    "biome": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "editorconfig": true,
    "fish": true,
    "git-firefly": true,
    "golangci-lint": true,
    "html": true,
    "make": true,
    "toml": true,
    "tsgo": true
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "ZedMono Nerd Font",
  "buffer_font_size": 20,
  "buffer_line_height": "standard",
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "button": false
  },
  "debugger": {
    "dock": "right"
  },
  "disable_ai": false,
  "experimental.theme_overrides": {
    "editor.gutter.background": "#0b0b11",
    "terminal.background": "#0b0b11"
  },
  "file_types": {
    "dotenv": [".env", ".env.example", ".env.sample"],
    "git-rebase": [".gitconfig.work"],
    "jsonc": ["**/settings.json"]
  },
  "format_on_save": "on",
  "git_panel": {
    "dock": "left"
  },
  "gutter": {
    "min_line_number_digits": 0
  },
  "hover_popover_delay": 500,
  "icon_theme": "Catppuccin Mocha",
  "languages": {
    "CSS": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["!eslint", "..."]
    },
    "Go": {
      "formatter": {
        "external": {
          "arguments": ["exec", "--", "golangci-lint", "fmt", "--stdin"],
          "command": "mise"
        }
      },
      "language_servers": ["gopls", "golangci-lint"]
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "2"]
        }
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "..."
      ]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "..."
      ]
    }
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "mise",
          "exec",
          "--",
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    },
    "gopls": {
      "binary": {
        "arguments": ["exec", "--", "gopls"],
        "path": "mise"
      }
    }
  },
  "minimap": {
    "show": "never"
  },
  "preferred_line_length": 100,
  "project_panel": {
    "auto_fold_dirs": false,
    "diagnostic_badges": true,
    "dock": "left",
    "entry_spacing": "standard",
    "git_status_indicator": true,
    "hide_hidden": false,
    "hide_root": true,
    "indent_guides": {
      "show": "always"
    }
  },
  "show_edit_predictions": true,
  "show_whitespaces": "boundary",
  "soft_wrap": "none",
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "flexible": false,
    "blinking": "on",
    "cursor_shape": "bar",
    "dock": "right",
    "font_family": "IosevkaTerm Nerd Font",
    "font_size": 18
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Mocha",
    "mode": "dark"
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_sign_in": false
  },
  "ui_font_family": "Hack Nerd Font",
  "ui_font_size": 18,
  "unnecessary_code_fade": 0.6,
  "wrap_guides": [80, 100]
}
